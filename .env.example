# Copiez ce fichier en .env.local (développement) ou renseignez ces variables
# dans les réglages du projet Vercel (production).

# Base de données PostgreSQL (locale en dev, Neon serverless en production)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Mot de passe du tableau de bord admin (/admin)
ADMIN_PASSWORD=votre-mot-de-passe-admin

# URL publique du site (canonical, sitemap, images de partage, liens dans les emails).
# Sur Vercel, VERCEL_PROJECT_PRODUCTION_URL est utilisée automatiquement si cette
# variable est absente ; en dernier recours : https://futurcraft.bj
NEXT_PUBLIC_SITE_URL=https://futurcraft.bj

# Notifications email des formulaires (contact, inscriptions événements, newsletter).
# Sans RESEND_API_KEY, les demandes sont quand même enregistrées en base et visibles
# dans /admin (onglet « Demandes du site ») — seuls les emails ne partent pas.
# Clé API : https://resend.com (offre gratuite : 3 000 emails / mois)
RESEND_API_KEY=
# Expéditeur : le domaine doit être vérifié chez Resend (DNS). En attendant, l'adresse
# de test onboarding@resend.dev fonctionne mais n'envoie qu'au compte propriétaire.
MAIL_FROM=FuturCraft Institut <notifications@futurcraft.bj>
# Boîte(s) qui reçoivent les demandes, séparées par des virgules
MAIL_TO=contact@futurcraftinstitut.com
